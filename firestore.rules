rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Staad Firestore security rules
//
// REPLACES a catch-all `match /{document=**} { allow read, write: if
// request.auth != null; }` under which ANY authenticated account could read and
// write EVERY document — every patient's transcript, attention score, consent
// state and therapist notes.
//
// ── The entitlement model ───────────────────────────────────────────────────
// Firestore does not know who is entitled to a session. That lives in Postgres
// (`Session.therapistId -> ProfileTherapist.userId`, `Session.clientId ->
// ProfileClient.userId`) and rules cannot query it.
//
// So entitlement is MIRRORED into Firestore as `liveSessions/{id}.allowedUids`,
// written ONLY by the server through the Admin SDK (which bypasses rules) in
// src/lib/session-provisioning.ts. Every session-scoped rule below authorises
// against that one field.
//
// This is why clients may not create or delete `liveSessions`, and may never
// modify `allowedUids`: if a client could write it, it would be self-issued
// authorisation and the whole model would be circular.
//
// ── Seats, not roles ────────────────────────────────────────────────────────
// A role claim says someone is *a* therapist, not *this patient's* therapist.
// So nothing here authorises on `request.auth.token.role`. Instead the server
// mirrors the specific relationships from Postgres:
//   liveSessions/{id}.therapistUid / clientUid — who holds which seat
//   patients/{uid}.therapistUids                — who treats this patient
// Un-backfilled documents lack these fields and fail closed; see
// scripts/backfill-session-privacy.mjs.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function liveSessionData(sid) {
      return get(/databases/$(database)/documents/liveSessions/$(sid)).data;
    }

    function liveSessionExists(sid) {
      return exists(/databases/$(database)/documents/liveSessions/$(sid));
    }

    // The single authorisation predicate for everything session-scoped.
    // Fails closed: no liveSessions doc, or no allowedUids on it, means no access.
    function isSessionMember(sid) {
      return signedIn()
        && liveSessionExists(sid)
        && liveSessionData(sid).keys().hasAny(['allowedUids'])
        && request.auth.uid in liveSessionData(sid).allowedUids;
    }

    // Which member is which. `therapistUid` / `clientUid` sit beside
    // allowedUids on liveSessions/{id} and are written by the same server-side
    // provisioning, so they are as trustworthy as allowedUids. Missing on an
    // un-backfilled room → '' → never equals a uid → fails closed.
    function isSessionTherapist(sid) {
      return isSessionMember(sid)
        && liveSessionData(sid).get('therapistUid', '') == request.auth.uid;
    }

    function isSessionClient(sid) {
      return isSessionMember(sid)
        && liveSessionData(sid).get('clientUid', '') == request.auth.uid;
    }

    // Therapist-only fields. They live in sessions/{id}/private/therapist and
    // must never be (re)introduced on the member-readable session document.
    function therapistOnlyFields() {
      return ['therapistNotes', 'therapistNotesLastUpdated', 'aiInsight', 'aiInsightGeneratedAt',
              'riskDetail', 'copilotEvents', 'copilotEventsLastUpdated'];
    }

    function consentUnchanged(party) {
      return request.resource.data.get('aiConsent', {}).get(party, null)
        == resource.data.get('aiConsent', {}).get(party, null);
    }

    // ── liveSessions/{sessionId} ────────────────────────────────────────────
    // Real-time room state: participants, active module, module state,
    // whiteboard flags, reactions. Both participants read and write it
    // constantly during a call.
    //
    // Provisioned server-side. A client that could create this document could
    // mint its own `allowedUids` and thereby grant itself access to any
    // session id it can guess.
    match /liveSessions/{sessionId} {
      allow get, list: if isSessionMember(sessionId);

      allow create: if false;
      allow delete: if false;

      // Members may update room state, but never the entitlement itself or
      // who holds which seat.
      allow update: if isSessionMember(sessionId)
        && request.resource.data.allowedUids == resource.data.allowedUids
        && request.resource.data.get('therapistUid', null) == resource.data.get('therapistUid', null)
        && request.resource.data.get('clientUid', null) == resource.data.get('clientUid', null);
    }

    // ── sessions/{sessionId} ────────────────────────────────────────────────
    // The durable session record both members see: aiConsent, transcript[],
    // moduleEvents[]. Therapist-only data is in private/therapist below.
    //
    // Authorised off the SAME allowedUids as the live room, so the two can
    // never disagree. Also provisioned server-side; the client only updates.
    //
    // Each party may change only its own consent: the therapist can never set
    // aiConsent.client and the client can never set aiConsent.therapist. Who is
    // who comes from the server-written seats, never from the request.
    match /sessions/{sessionId} {
      allow get, list: if isSessionMember(sessionId);

      allow create: if false;
      allow delete: if false;

      allow update: if isSessionMember(sessionId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(therapistOnlyFields())
        && (
             (isSessionTherapist(sessionId) && consentUnchanged('client'))
             ||
             (isSessionClient(sessionId) && consentUnchanged('therapist'))
           );

      // ── private/therapist: therapist-only session data ───────────────────
      // therapistNotes[], aiInsight (incl. riskDetail) and the copilotEvents[]
      // audit log. Only the session's own therapist may read it; the client,
      // other therapists and anonymous users are refused.
      //
      // The therapist writes notes only. aiInsight and copilotEvents are
      // written by the server (Admin SDK) so the audit trail can't be forged.
      match /private/{docId} {
        allow get: if docId == 'therapist' && isSessionTherapist(sessionId);
        allow list: if false;

        allow create: if docId == 'therapist' && isSessionTherapist(sessionId)
          && request.resource.data.keys().hasOnly(['therapistNotes', 'therapistNotesLastUpdated']);
        allow update: if docId == 'therapist' && isSessionTherapist(sessionId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['therapistNotes', 'therapistNotesLastUpdated']);

        allow delete: if false;
      }

      // ── rawSessionLog: the session diary ─────────────────────────────────
      // Append-only time series of attention scores (and, once the deferred
      // dual-write lands, transcript entries). Immutable by design: this is
      // clinical observation data, so history must not be rewritten after the
      // fact. Deletion is a server-side retention concern, not a client one.
      match /rawSessionLog/{entryId} {
        allow get, list: if isSessionMember(sessionId);

        allow create: if isSessionMember(sessionId)
          && request.resource.data.keys().hasOnly(['timestamp', 'type', 'value'])
          && request.resource.data.keys().hasAll(['timestamp', 'type', 'value'])
          && request.resource.data.type in ['attention', 'transcript']
          && (
               (request.resource.data.type == 'attention'
                 && request.resource.data.value is int
                 && request.resource.data.value >= 0
                 && request.resource.data.value <= 100)
               ||
               (request.resource.data.type == 'transcript'
                 && request.resource.data.value is string
                 && request.resource.data.value.size() <= 10000)
             );

        allow update, delete: if false;
      }
    }

    // ── moduleStates/{sessionId}_{moduleId} ─────────────────────────────────
    // Shared per-module state. The session id is encoded in the document id,
    // so authorisation derives from the prefix before the first underscore.
    // Session ids are UUIDs (no underscores), so this split is unambiguous
    // regardless of what the module id contains.
    match /moduleStates/{stateId} {
      allow get, list: if isSessionMember(stateId.split('_')[0]);
      allow create, update: if isSessionMember(stateId.split('_')[0]);
      allow delete: if false;
    }

    // ── patients/{patientUid} ───────────────────────────────────────────────
    // Cross-session per-patient data (currently MicroQuestBoard's quest list).
    // Keyed by the patient's Firebase UID.
    //
    // Not session-scoped, so allowedUids cannot authorise it. The patient
    // themselves always has access. A therapist has access only if their uid
    // is in `therapistUids`, which the server seeds from Postgres sessions
    // (src/lib/session-provisioning.ts) exactly as it seeds allowedUids.
    // Nobody may edit that list from the client — it would be self-issued
    // authorisation. No list → no therapist access (fails closed).
    match /patients/{patientUid} {
      allow get: if signedIn()
        && (request.auth.uid == patientUid
            || request.auth.uid in resource.data.get('therapistUids', []));
      allow list: if false;

      // Only the patient may create their own document, and without seats.
      // Therapists never create it: the server does, with therapistUids set.
      allow create: if signedIn() && request.auth.uid == patientUid
        && !request.resource.data.keys().hasAny(['therapistUids']);

      allow update: if signedIn()
        && (request.auth.uid == patientUid
            || request.auth.uid in resource.data.get('therapistUids', []))
        && request.resource.data.get('therapistUids', []) == resource.data.get('therapistUids', []);

      allow delete: if false;
    }

    // ── Default deny ────────────────────────────────────────────────────────
    // Anything not matched above is refused. This replaces the permissive
    // catch-all. A NEW collection added in code will be denied until a rule is
    // written for it here — that is deliberate: fail closed, not open.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
