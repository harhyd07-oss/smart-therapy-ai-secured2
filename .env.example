# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# server.js loads it via @next/env, so restart `npm run dev` after any change.

# ---- Required for sign-up / onboarding / anything that touches Postgres ----
# Any Postgres 15+ with the pgvector extension (Neon, Supabase, or local).
# Local dev must use a Neon *development branch*, never production.
# After setting it: npx prisma generate && npx prisma db push
DATABASE_URL=

# ---- Required for role custom claims (onboarding still works without it,
#      but Firestore rules cannot tell a therapist from a client) ----
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=staad-edtech
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@staad-edtech.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Feature-specific. Leave blank until you need that feature. ----
# Video sessions
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=wss://...

# AI insights / RAG embeddings
NVIDIA_API_KEY=
# OpenRouter: AI copilot, safety check and session report all use MODEL.
# OPENROUTER_API_KEY and MODEL are REQUIRED in production — every AI call checks
# them (this is what protects Vercel), and `npm start` refuses to boot without them.
# NOTE: openai/gpt-oss-20b:free is a FREE validation model. It is NOT a paid,
# private or zero-retention service — do not treat it as one.
OPENROUTER_API_KEY=
MODEL=openai/gpt-oss-20b:free
OPENROUTER_SITE_URL=

# Speech-to-text
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=
SARVAM_API_KEY=
# Dev only: "true" lets transcription + AI copilot run on therapist consent alone,
# so you can test solo. Ignored when NODE_ENV=production.
NEXT_PUBLIC_STT_TEST_MODE=

# Invite emails
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Scheduled jobs + admin seeding
CRON_SECRET=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
